{
  "info": {
    "_postman_id": "retag-api-collection",
    "name": "ReTag API",
    "description": "Postman collection for the ReTag NestJS backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": []
    },
    {
      "name": "Bags",
      "item": []
