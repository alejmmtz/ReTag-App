                "events",
                "{{eventId}}"
              ]
            }
          }
        },
        {
          "name": "Join event",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/join",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "join"
              ]
